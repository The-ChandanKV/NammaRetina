# Flask
SECRET_KEY=change-me-to-a-long-random-string
FLASK_DEBUG=0
PORT=8080

# Supabase
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_KEY=your-anon-public-key
SUPABASE_SERVICE_KEY=your-service-role-key

# LLM (optional — falls back to rule-based text if unset)
GEMINI_API_KEY=

# Trained model (optional). If models/efficientnetb0_dr.keras is missing at boot,
# the app downloads from this URL (Google Drive uc?id=FILE_ID or direct HTTPS).
MODEL_URL=
# SHA256 from training/outputs/<run>/model.sha256. Rejects corrupt/wrong artifacts.
MODEL_SHA256=
